AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=replace-with-your-key
AI_MODEL=deepseek-chat
# openai uses an OpenAI-compatible model; heuristic skips external AI calls.
RADAR_AI_MODE=openai
RADAR_TIMEZONE=Asia/Shanghai
RADAR_MIN_ITEMS=10
RADAR_MAX_ITEMS=20
RADAR_CANDIDATE_POOL_MAX=80
RADAR_MAX_PER_SOURCE=8
RSSHUB_BASE_URL=https://rsshub.app
LARK_CHAT_ID=oc_replace_with_chat_id
# Or use LARK_USER_ID=ou_replace_with_user_id
LARK_ALLOWED_CHAT_IDS=oc_replace_with_chat_id
LARK_ALLOWED_SENDER_IDS=ou_replace_with_your_open_id
OBSIDIAN_READING_LIST_FILE=/absolute/path/to/reading-list.md
RADAR_DAILY_HOUR=8
RADAR_DAILY_MINUTE=30
# Keep production data outside the repository.
# Default: ../daily-info-radar.local-data
# RADAR_DATA_DIR=/absolute/path/to/daily-info-radar.local-data
