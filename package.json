{
  "name": "daily-info-radar",
  "version": "0.1.0",
  "description": "Local-first daily AI, tech, and market information radar with Lark/Feishu delivery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HANKSEN/daily-info-radar.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "daily": "node --experimental-strip-types src/cli.ts daily",
    "daily:dry": "node --experimental-strip-types src/cli.ts daily --dry-run",
    "collect": "node --experimental-strip-types src/cli.ts collect",
    "analyze": "node --experimental-strip-types src/cli.ts analyze",
    "render": "node --experimental-strip-types src/cli.ts render",
    "sources": "node --experimental-strip-types src/cli.ts sources",
    "sources:check": "node --experimental-strip-types src/cli.ts sources:check",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "send:latest": "node --experimental-strip-types src/cli.ts send:latest",
    "obsidian:add": "node --experimental-strip-types src/cli.ts obsidian:add",
    "bot": "node --experimental-strip-types src/cli.ts bot",
    "launchd:print": "node --experimental-strip-types src/cli.ts launchd:print",
    "launchd:install": "node --experimental-strip-types src/cli.ts launchd:install",
    "launchd:uninstall": "node --experimental-strip-types src/cli.ts launchd:uninstall"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
